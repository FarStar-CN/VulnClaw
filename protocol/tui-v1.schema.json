{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulnclaw.dev/protocol/tui-v1.schema.json",
  "title": "VulnClaw local TUI protocol v1",
  "description": "One UTF-8 JSON object per line over a local stdio session.",
  "oneOf": [
    { "$ref": "#/$defs/clientMessage" },
    { "$ref": "#/$defs/serverEvent" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "envelope": {
      "type": "object",
      "required": ["protocol_version", "type"],
      "properties": {
        "protocol_version": { "const": 1 },
        "type": { "type": "string", "minLength": 1 },
        "request_id": { "$ref": "#/$defs/identifier" },
        "task_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "requestEnvelope": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "required": ["request_id", "payload"],
          "properties": {
            "payload": { "type": "object" }
          }
        }
      ]
    },
    "taskRequestEnvelope": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        { "required": ["task_id"] }
      ]
    },
    "taskEventEnvelope": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "required": ["task_id"] }
      ]
    },

    "clientInfo": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "target": { "type": "string" },
        "mode": { "type": "string" },
        "command": {
          "enum": ["run", "scan", "recon", "exploit", "persistent"]
        },
        "only_host": { "type": ["string", "null"] },
        "only_port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
        "only_path": { "type": ["string", "null"] },
        "blocked_host": { "type": ["string", "null"] },
        "blocked_path": { "type": ["string", "null"] },
        "allow_actions": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "block_actions": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "resume": { "type": "boolean" }
      }
    },
    "initializePayload": {
      "type": "object",
      "properties": {
        "client": { "$ref": "#/$defs/clientInfo" },
        "bootstrap": { "$ref": "#/$defs/bootstrap" }
      }
    },
    "commandPayload": {
      "type": "object",
      "required": ["command_line"],
      "properties": {
        "command_line": { "type": "string", "minLength": 1 }
      }
    },
    "controlPayload": {
      "type": "object",
      "required": ["operation", "arguments"],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" }
      }
    },
    "emptyPayload": {
      "type": "object",
      "maxProperties": 0
    },

    "initializeRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "initialize" },
            "payload": { "$ref": "#/$defs/initializePayload" }
          }
        }
      ]
    },
    "startTaskRequest": {
      "allOf": [
        { "$ref": "#/$defs/taskRequestEnvelope" },
        {
          "properties": {
            "type": { "const": "start_task" },
            "payload": { "$ref": "#/$defs/commandPayload" }
          }
        }
      ]
    },
    "cancelTaskRequest": {
      "allOf": [
        { "$ref": "#/$defs/taskRequestEnvelope" },
        {
          "properties": {
            "type": { "const": "cancel_task" },
            "payload": { "$ref": "#/$defs/emptyPayload" }
          }
        }
      ]
    },
    "getStateRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "get_state" },
            "payload": { "$ref": "#/$defs/emptyPayload" }
          }
        }
      ]
    },
    "controlRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "control" },
            "payload": { "$ref": "#/$defs/controlPayload" }
          }
        }
      ]
    },
    "shutdownRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "type": { "const": "shutdown" },
            "payload": { "$ref": "#/$defs/emptyPayload" }
          }
        }
      ]
    },
    "clientMessage": {
      "oneOf": [
        { "$ref": "#/$defs/initializeRequest" },
        { "$ref": "#/$defs/startTaskRequest" },
        { "$ref": "#/$defs/cancelTaskRequest" },
        { "$ref": "#/$defs/getStateRequest" },
        { "$ref": "#/$defs/controlRequest" },
        { "$ref": "#/$defs/shutdownRequest" }
      ]
    },

    "taskConstraints": {
      "type": "object",
      "properties": {
        "allowed_ports": { "type": "array", "items": { "type": "integer" } },
        "blocked_ports": { "type": "array", "items": { "type": "integer" } },
        "allowed_hosts": { "type": "array", "items": { "type": "string" } },
        "blocked_hosts": { "type": "array", "items": { "type": "string" } },
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "blocked_paths": { "type": "array", "items": { "type": "string" } },
        "allowed_actions": { "type": "array", "items": { "type": "string" } },
        "blocked_actions": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } },
        "strict_mode": { "type": "boolean" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "path": { "type": "string" },
        "request_id": { "type": ["string", "null"] }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "title", "target"],
      "properties": {
        "id": { "type": "string" },
        "severity": { "type": "string" },
        "title": { "type": "string" },
        "target": { "type": "string" },
        "vuln_type": { "type": "string" },
        "description": { "type": "string" },
        "impact": { "type": "string" },
        "evidence": { "type": "string" },
        "cve": { "type": ["string", "null"] },
        "cvss": { "type": ["number", "null"] },
        "cwe": { "type": ["string", "null"] },
        "remediation": { "type": "string" },
        "endpoint": { "type": ["string", "null"] },
        "method": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"] },
        "code_location": { "type": ["string", "null"] },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "poc_script": { "type": ["string", "null"] },
        "evidence_level": { "type": "string" },
        "lifecycle_status": { "type": "string" },
        "verified": { "type": "boolean" },
        "verification_status": { "type": "string" },
        "verified_at": { "type": ["string", "null"] },
        "verification_note": { "type": "string" },
        "chain_depends_on": { "type": "array", "items": { "type": "string" } }
      }
    },
    "backendTaskState": {
      "type": "object",
      "required": ["active", "task_id"],
      "properties": {
        "active": { "type": "boolean" },
        "task_id": { "type": ["string", "null"] }
      }
    },
    "stateSnapshot": {
      "type": "object",
      "required": [
        "target",
        "phase",
        "task_constraints",
        "task",
        "last_run",
        "findings",
        "evidence",
        "constraint_violations"
      ],
      "properties": {
        "target": { "type": "string" },
        "phase": { "type": "string" },
        "task_constraints": { "$ref": "#/$defs/taskConstraints" },
        "task": { "$ref": "#/$defs/backendTaskState" },
        "last_run": { "type": ["object", "null"] },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "constraint_violations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "backendInfo": {
      "type": "object",
      "required": ["pid", "version", "protocol_version"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "version": { "type": "string" },
        "protocol_version": { "const": 1 }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["commands", "cancellation", "authoritative_state"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "uniqueItems": true
        },
        "control_operations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "cancellation": { "type": "boolean" },
        "authoritative_state": { "type": "boolean" }
      }
    },
    "runtimeInfo": {
      "type": "object",
      "required": ["config_ready", "provider", "model", "mcp_started", "skills"],
      "properties": {
        "config_ready": { "type": "boolean" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "mcp_started": { "type": "integer", "minimum": 0 },
        "skills": { "type": "array", "items": { "type": "string" } }
      }
    },
    "taskResult": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "exit_code": { "type": "integer" },
        "summary": { "type": "object" },
        "run": {
          "type": ["object", "null"],
          "properties": {
            "name": { "type": "string" },
            "directory": { "type": "string" },
            "manifest": { "type": "object" }
          }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    },
    "structuredError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },

    "readyEvent": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "required": ["request_id", "backend", "capabilities", "runtime", "state"],
          "properties": {
            "type": { "const": "ready" },
            "backend": { "$ref": "#/$defs/backendInfo" },
            "capabilities": { "$ref": "#/$defs/capabilities" },
            "runtime": { "$ref": "#/$defs/runtimeInfo" },
            "state": { "$ref": "#/$defs/stateSnapshot" }
          }
        }
      ]
    },
    "stateEvent": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "required": ["state"],
          "properties": {
            "type": { "const": "state" },
            "state": { "$ref": "#/$defs/stateSnapshot" }
          }
        }
      ]
    },
    "taskStartedEvent": {
      "allOf": [
        { "$ref": "#/$defs/taskEventEnvelope" },
        {
          "required": ["request_id", "command", "normalized_command", "target", "resume", "constraints", "state"],
          "properties": {
            "type": { "const": "task_started" },
            "command": { "type": "string" },
            "normalized_command": { "type": "string" },
            "target": { "type": "string" },
            "resume": { "type": "boolean" },
            "constraints": { "$ref": "#/$defs/taskConstraints" },
            "state": { "$ref": "#/$defs/stateSnapshot" }
          }
        }
      ]
    },
    "statusEvent": {
      "allOf": [
        { "$ref": "#/$defs/taskEventEnvelope" },
        {
          "required": ["status"],
          "properties": {
            "type": { "const": "status" },
            "status": { "type": "string" }
          }
        }
      ]
    },
    "reasoningEvent": {
      "allOf": [
        { "$ref": "#/$defs/taskEventEnvelope" },
        {
          "required": ["text"],
          "properties": {
            "type": { "const": "reasoning" },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "logEvent": {
      "allOf": [
        { "$ref": "#/$defs/taskEventEnvelope" },
        {
          "required": ["message"],
          "properties": {
            "type": { "const": "log" },
            "message": { "type": "string" }
          }
        }
      ]
    },
    "toolCallEvent": {
      "allOf": [
        { "$ref": "#/$defs/taskEventEnvelope" },
        {
          "required": ["tool", "arguments"],
          "properties": {
            "type": { "const": "tool_call" },
            "tool": { "type": "string" },
            "arguments": { "type": "string" }
          }
        }
      ]
    },
    "toolResultEvent": {
      "allOf": [
        { "$ref": "#/$defs/taskEventEnvelope" },
        {
          "required": ["result"],
          "properties": {
            "type": { "const": "tool_result" },
            "result": { "type": "string" }
          }
        }
      ]
    },
    "findingEvent": {
      "allOf": [
        { "$ref": "#/$defs/taskEventEnvelope" },
        {
          "required": ["finding"],
          "properties": {
            "type": { "const": "finding" },
            "finding": { "$ref": "#/$defs/finding" }
          }
        }
      ]
    },
    "approvalRequiredEvent": {
      "allOf": [
        { "$ref": "#/$defs/taskEventEnvelope" },
        {
          "required": ["question"],
          "properties": {
            "type": { "const": "approval_required" },
            "question": { "type": "string" }
          }
        }
      ]
    },
    "taskCompletedEvent": {
      "allOf": [
        { "$ref": "#/$defs/taskEventEnvelope" },
        {
          "required": ["request_id", "result", "findings", "state"],
          "properties": {
            "type": { "const": "task_completed" },
            "result": { "$ref": "#/$defs/taskResult" },
            "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
            "state": { "$ref": "#/$defs/stateSnapshot" }
          }
        }
      ]
    },
    "taskCancelledEvent": {
      "allOf": [
        { "$ref": "#/$defs/taskEventEnvelope" },
        {
          "required": ["request_id", "state"],
          "properties": {
            "type": { "const": "task_cancelled" },
            "state": { "$ref": "#/$defs/stateSnapshot" }
          }
        }
      ]
    },
    "taskFailedEvent": {
      "allOf": [
        { "$ref": "#/$defs/taskEventEnvelope" },
        {
          "required": ["request_id", "error", "state"],
          "properties": {
            "type": { "const": "task_failed" },
            "error": { "$ref": "#/$defs/structuredError" },
            "state": { "$ref": "#/$defs/stateSnapshot" }
          }
        }
      ]
    },
    "errorEvent": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "required": ["code", "message"],
          "properties": {
            "type": { "const": "error" },
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      ]
    },
    "controlResultEvent": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "required": ["request_id", "operation", "result"],
          "properties": {
            "type": { "const": "control_result" },
            "operation": { "type": "string", "minLength": 1 },
            "result": { "type": "object" },
            "state": { "$ref": "#/$defs/stateSnapshot" }
          }
        }
      ]
    },
    "shutdownCompleteEvent": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "required": ["request_id"],
          "properties": {
            "type": { "const": "shutdown_complete" }
          }
        }
      ]
    },
    "serverEvent": {
      "oneOf": [
        { "$ref": "#/$defs/readyEvent" },
        { "$ref": "#/$defs/stateEvent" },
        { "$ref": "#/$defs/taskStartedEvent" },
        { "$ref": "#/$defs/statusEvent" },
        { "$ref": "#/$defs/reasoningEvent" },
        { "$ref": "#/$defs/logEvent" },
        { "$ref": "#/$defs/toolCallEvent" },
        { "$ref": "#/$defs/toolResultEvent" },
        { "$ref": "#/$defs/findingEvent" },
        { "$ref": "#/$defs/approvalRequiredEvent" },
        { "$ref": "#/$defs/taskCompletedEvent" },
        { "$ref": "#/$defs/taskCancelledEvent" },
        { "$ref": "#/$defs/taskFailedEvent" },
        { "$ref": "#/$defs/controlResultEvent" },
        { "$ref": "#/$defs/errorEvent" },
        { "$ref": "#/$defs/shutdownCompleteEvent" }
      ]
    }
  }
}
